# ==========================================
# SIMPLE CHATBOT AI ASSISTANT
# ==========================================
# Beginner-Friendly Python AI Assistant
# Features:
# - Greetings
# - Time & Date
# - Basic Math
# - Simple AI Responses
# - Memory System
# - Exit Command
# ==========================================

import datetime
import random

# ==========================================
# MEMORY
# ==========================================

memory = {
    "name": None
}

# ==========================================
# RESPONSES
# ==========================================

greetings = [
    "Hello!",
    "Hi there!",
    "Hey!",
    "Nice to meet you!"
]

how_are_you = [
    "I'm doing great!",
    "I'm functioning perfectly!",
    "All systems operational!",
    "Doing well!"
]

unknown_responses = [
    "I don't understand that yet.",
    "Can you rephrase that?",
    "Interesting... tell me more.",
    "I'm still learning."
]

# ==========================================
# CHATBOT FUNCTION
# ==========================================

def chatbot():

    print("=" * 50)
    print("      AI CHATBOT ASSISTANT")
    print("=" * 50)
    print("Type 'exit' to quit.\n")

    while True:

        user_input = input("You: ").lower()

        # ==============================
        # EXIT
        # ==============================

        if user_input == "exit":
            print("Bot: Goodbye!")
            break

        # ==============================
        # GREETINGS
        # ==============================

        elif user_input in ["hello", "hi", "hey"]:
            print("Bot:", random.choice(greetings))

        # ==============================
        # HOW ARE YOU
        # ==============================

        elif "how are you" in user_input:
            print("Bot:", random.choice(how_are_you))

        # ==============================
        # NAME MEMORY
        # ==============================

        elif "my name is" in user_input:

            name = user_input.replace("my name is", "").strip()
            memory["name"] = name

            print(f"Bot: Nice to meet you, {name.title()}!")

        elif "what is my name" in user_input:

            if memory["name"]:
                print(f"Bot: Your name is {memory['name'].title()}.")
            else:
                print("Bot: I don't know your name yet.")

        # ==============================
        # TIME
        # ==============================

        elif "time" in user_input:

            current_time = datetime.datetime.now().strftime("%H:%M:%S")
            print(f"Bot: Current time is {current_time}")

        # ==============================
        # DATE
        # ==============================

        elif "date" in user_input:

            current_date = datetime.datetime.now().strftime("%Y-%m-%d")
            print(f"Bot: Today's date is {current_date}")

        # ==============================
        # BASIC MATH
        # ==============================

        elif "calculate" in user_input:

            try:
                expression = user_input.replace("calculate", "")
                result = eval(expression)

                print(f"Bot: The answer is {result}")

            except:
                print("Bot: Invalid calculation.")

        # ==============================
        # JOKES
        # ==============================

        elif "joke" in user_input:

            jokes = [
                "Why do programmers prefer dark mode? Because light attracts bugs.",
                "Why was the computer cold? It left its Windows open.",
                "Why did the AI go to school? To improve its neural network."
            ]

            print("Bot:", random.choice(jokes))

        # ==============================
        # AI-LIKE RESPONSE
        # ==============================

        elif "ai" in user_input:
            print("Bot: Artificial Intelligence is fascinating!")

        # ==============================
        # UNKNOWN
        # ==============================

        else:
            print("Bot:", random.choice(unknown_responses))


# ==========================================
# RUN PROGRAM
# ==========================================

chatbot()
