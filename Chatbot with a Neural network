import numpy as np
import random
import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense
from tensorflow.keras.optimizers import Adam

# =========================================================
# TRAINING DATA
# =========================================================

training_sentences = [
    "hello",
    "hi",
    "hey",
    "good morning",

    "how are you",
    "are you okay",
    "how do you feel",

    "bye",
    "goodbye",
    "see you",

    "tell me a joke",
    "make me laugh",

    "what is ai",
    "what is artificial intelligence",

    "what time is it",
    "tell me the time"
]

training_labels = [
    "greeting",
    "greeting",
    "greeting",
    "greeting",

    "status",
    "status",
    "status",

    "goodbye",
    "goodbye",
    "goodbye",

    "joke",
    "joke",

    "ai",
    "ai",

    "time",
    "time"
]

responses = {
    "greeting": [
        "Hello!",
        "Hi there!",
        "Hey!",
        "Nice to meet you!"
    ],

    "status": [
        "I'm doing great!",
        "All systems operational!",
        "I'm functioning perfectly!"
    ],

    "goodbye": [
        "Goodbye!",
        "See you later!",
        "Have a nice day!"
    ],

    "joke": [
        "Why do programmers hate bugs? Because they take too long to debug.",
        "Why was the computer cold? It left its Windows open."
    ],

    "ai": [
        "Artificial Intelligence allows computers to learn patterns.",
        "AI is the simulation of human intelligence in machines."
    ],

    "time": [
        "I cannot access live time yet, but you can add that feature."
    ]
}

# =========================================================
# BUILD VOCABULARY
# =========================================================

vocab = sorted(set(" ".join(training_sentences).split()))

word_to_index = {word: i for i, word in enumerate(vocab)}

# =========================================================
# TEXT TO VECTOR
# =========================================================

def sentence_to_vector(sentence):

    vector = np.zeros(len(vocab))

    for word in sentence.lower().split():

        if word in word_to_index:
            vector[word_to_index[word]] = 1

    return vector

# =========================================================
# PREPARE TRAINING DATA
# =========================================================

X = np.array([sentence_to_vector(sentence)
              for sentence in training_sentences])

unique_labels = sorted(set(training_labels))

label_to_index = {
    label: i for i, label in enumerate(unique_labels)
}

index_to_label = {
    i: label for label, i in label_to_index.items()
}

y = np.array([
    label_to_index[label]
    for label in training_labels
])

# =========================================================
# BUILD NEURAL NETWORK
# =========================================================

model = Sequential()

model.add(Dense(16,
                input_dim=len(vocab),
                activation='relu'))

model.add(Dense(16,
                activation='relu'))

model.add(Dense(len(unique_labels),
                activation='softmax'))

# =========================================================
# COMPILE MODEL
# =========================================================

model.compile(
    loss='sparse_categorical_crossentropy',
    optimizer=Adam(learning_rate=0.01),
    metrics=['accuracy']
)

# =========================================================
# TRAIN MODEL
# =========================================================

print("=" * 50)
print("TRAINING NEURAL NETWORK...")
print("=" * 50)

model.fit(X, y, epochs=300, verbose=0)

print("Training Complete!\n")

# =========================================================
# PREDICT INTENT
# =========================================================

def predict_intent(sentence):

    vector = np.array([sentence_to_vector(sentence)])

    prediction = model.predict(vector, verbose=0)

    predicted_index = np.argmax(prediction)

    confidence = np.max(prediction)

    return index_to_label[predicted_index], confidence

# =========================================================
# CHATBOT LOOP
# =========================================================

print("=" * 50)
print("      NEURAL NETWORK CHATBOT")
print("=" * 50)
print("Type 'exit' to quit.\n")

while True:

    user_input = input("You: ")

    if user_input.lower() == "exit":
        print("Bot: Goodbye!")
        break

    intent, confidence = predict_intent(user_input)

    # LOW CONFIDENCE
    if confidence < 0.4:
        print("Bot: I'm not sure I understand.")
        continue

    response = random.choice(responses[intent])

    print(f"Bot: {response}")

    print(f"(Intent: {intent} | Confidence: {confidence:.2f})\n")
